  "interfaces": [
    {
      "source": {
        "reason": "Section 4.1 and 4.2 describe the precipitate/matrix interfaces and dislocation interactions (κ-carbide shearing, (Nb,Mo,W)C Orowan bypassing), the ductile-fracture role of intergranular (Nb,Mo,W)C, and the formation of κ-carbides by spinodal decomposition during water quenching.",
        "block_id": [
          "b0034",
          "b0038",
          "b0058",
          "b0059",
          "b0065",
          "b0066"
        ]
      },
      "interface_set_id": "int_HR45",
      "phase_interfaces": [
        {
          "interface_id": "int_HR45_kappa_austenite",
          "microstructure_id": "micro_HR45",
          "phase_1_name": {
            "value": "κ-carbide (Fe,Mn)3AlCx"
          },
          "phase_2_name": {
            "value": "austenite"
          },
          "coherence": {
            "value": "coherent; sheared by dislocations generating anti-phase boundaries (APBs)"
          }
        },
        {
          "interface_id": "int_HR45_NbMoWC_austenite",
          "microstructure_id": "micro_HR45",
          "phase_1_name": {
            "value": "(Nb,Mo,W)C"
          },
          "phase_2_name": {
            "value": "austenite"
          },
          "coherence": {
            "value": "incoherent; dislocations bypass via Orowan mechanism; strain/stress concentration at interfaces due to deformation discrepancy"
          }
        }
      ],
      "defect_interactions": [
        {
          "interaction_id": "int_HR45_shear_kappa",
          "microstructure_id": "micro_HR45",
          "interaction_type": {
            "value": "dislocation shearing of κ-carbides"
          },
          "qualitative_or_quantitative_description": {
            "value": "Shearing of κ-carbides by leading dislocations produces APBs and generates a preferential glide path (glide plane softening), leading to planar slip bands and Taylor lattice formation."
          }
        },
        {
          "interaction_id": "int_HR45_orowan",
          "microstructure_id": "micro_HR45",
          "interaction_type": {
            "value": "Orowan bypassing of (Nb,Mo,W)C"
          },
          "qualitative_or_quantitative_description": {
            "value": "Dislocations bypass incoherent (Nb,Mo,W)C particles via the Orowan mechanism; strengthening contribution 6.5 MPa for HR45."
          }
        },
        {
          "interaction_id": "int_HR45_crack_nucleation",
          "microstructure_id": "micro_HR45",
          "interaction_type": {
            "value": "intergranular (Nb,Mo,W)C microcrack nucleation / debonding"
          },
          "qualitative_or_quantitative_description": {
            "value": "Intergranular (Nb,Mo,W)C particles act as preferential nucleation sites for microcracks; strain/stress concentration partially alleviated by debonding of intragranular (Nb,Mo,W)C particles and microvoid formation. Intergranular (Nb,Mo,W)C particles virtually played no detrimental effect on toughness."
          }
        }
      ],
      "slip_behavior": {
        "value": "Predominant dislocation planar glide; planar slip bands refining with strain and evolving into microbands; Taylor lattice formed by intersection of two non-coplanar {111} slip traces. For HR45 the slip band spacing at εe = 0.1 was 296.40 ± 50.06 nm, refining to ~50 nm at higher strains."
      },
      "phase_evolution": {
        "value": "κ-carbides with L′12-type structure were produced by spinodal decomposition and subsequent ordering reaction during fast cooling (water quenching) without a further aging process."
      },
      "interface_notes": {
        "value": "The HR45 sample (coarser grains) showed microbands only at higher strains; microbands were observed at εe = 0.2 in HR68 and HR82, indicating faster substructure development with finer grain size."
      }
    }
  ],
