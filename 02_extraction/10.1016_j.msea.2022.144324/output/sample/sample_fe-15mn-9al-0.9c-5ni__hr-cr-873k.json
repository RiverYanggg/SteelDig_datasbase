  "structures": [
    {
      "source": {
        "reason": "Overall structure and HR-condition features (B2 ~12%, equiaxed γ ~5–7 μm, κ-carbides, twins) are described for 15Mn5Ni in blocks b0025/b0026/b0084; the HR+CR precursor state (deformed austenite with planar slip and sheared/fragmented B2 stringers, thickness ~8→2 μm) is described in b0026/b0027 and figure_001. The 873 K state itself was not separately characterized.",
        "block_id": [
          "b0025",
          "b0026",
          "b0027",
          "b0084",
          "figure_001"
        ]
      },
      "structure_id": "struct_15mn5ni",
      "overall_structure": {
        "value": "Fe–15Mn–9Al-0.9C–5Ni (15Mn5Ni) is a Ni-containing lower-Mn austenitic low-density steel whose microstructure consists of a γ-austenite matrix together with ordered B2 (Fe(Ni)Al-type) phase and κ-carbide precipitates; in the hot-rolled (HR) condition the B2 fraction (~12%) is higher than in the higher-Mn 28Mn5Ni alloy (~4%), and the alloy possesses the highest κ-carbide volume fraction among the three alloys."
      },
      "number_of_phases": {
        "value": "3"
      },
