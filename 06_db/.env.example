# ---------------------------------------------------------------------------
# SteelDig DB 本地开发配置。复制为 .env 后按需修改。
# 生产环境请改用托管密钥管理（Vault / KMS / 云厂商 Secret），不要提交 .env
# ---------------------------------------------------------------------------
POSTGRES_DB=steeldig
POSTGRES_USER=steeldig
POSTGRES_PASSWORD=steeldig_dev_pw
POSTGRES_PORT=5435

# ETL / API 使用的连接串
STEELDIG_DSN=postgresql://steeldig:steeldig_dev_pw@127.0.0.1:5435/steeldig

# 资产湖：local | s3
STEELDIG_LAKE_BACKEND=local
STEELDIG_LAKE_ROOT=../05_lake

# 语义检索（可选）。留空则跳过 embedding，向量列保持为空，全文检索仍可用。
# 模型需与 migrations/050_search.sql 中的 vector(384) 维度一致
STEELDIG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 国内网络可用镜像
HF_ENDPOINT=https://hf-mirror.com

# 嵌入模型缓存目录
STEELDIG_MODEL_CACHE=.cache/models

# 展示名（界面标题 / API 标题）。改这一行即可改名，无需动代码
STEELDIG_APP_NAME=SteelDig
