{"applicability_conditions":null,"identity":{"block_id":"b0099","equation_id":"equation_010","equation_number":"10","is_image":false,"latex_hint":"$$\n4 \\mathrm{Al} + 3 \\mathrm{O} _ {2} \\rightarrow 2 \\mathrm{Al} _ {2} \\mathrm{O} _ {3} \\Delta G ^ {\\circ} = - 7 5 6. 3 \\mathrm{kJ/mol}\\tag{10}\n$$","paper_id":"10.1016_j.corsci.2025.113331"},"latex":"4 \\mathrm{Al} + 3 \\mathrm{O}_{2} \\rightarrow 2 \\mathrm{Al}_{2}\\mathrm{O}_{3}, \\Delta G^{\\circ} = -756.3 \\mathrm{kJ/mol}","purpose":"表示铝被氧化生成氧化铝（Al₂O₃）的反应及其标准吉布斯自由能变，用于说明 Al 在所有温度范围内具有最强的氧化热力学驱动力。","symbols":[{"is_constant":false,"meaning":"铝（金属反应物）","symbol":"Al","unit":null,"value":null},{"is_constant":true,"meaning":"Al 的化学计量系数","symbol":"4","unit":null,"value":"4"},{"is_constant":false,"meaning":"氧气（氧化剂，反应物）","symbol":"O_{2}","unit":null,"value":null},{"is_constant":true,"meaning":"O₂ 的化学计量系数","symbol":"3","unit":null,"value":"3"},{"is_constant":false,"meaning":"氧化铝（热力学稳定产物）","symbol":"Al_{2}O_{3}","unit":null,"value":null},{"is_constant":true,"meaning":"Al₂O₃ 的化学计量系数","symbol":"2","unit":null,"value":"2"},{"is_constant":true,"meaning":"标准吉布斯自由能变（氧化反应的标准生成吉布斯自由能）","symbol":"\\Delta G^{\\circ}","unit":"kJ/mol","value":"-756.3"}],"unmapped":["该氧化反应的曲线位于 Ellingham 图底部，表明 Al 在所有温度范围内都具有最强的氧化热力学驱动力；即使在脱氧环境中，Al 也优先氧化生成热力学稳定的 Al₂O₃。","与 Fe、Mn 的氧化反应（式(11)、(12)，ΔG° 分别为 -116.7 kJ/mol 和 -173.4 kJ/mol）相比，Al 的 ΔG° 更低（-756.3 kJ/mol），更易氧化。"]}